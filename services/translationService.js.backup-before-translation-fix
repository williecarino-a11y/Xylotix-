const crypto = require('crypto');

const Translation =
  require('../models/Translation');

/*
 * =========================================================
 * MIIMIID TRANSLATION SERVICE
 * =========================================================
 *
 * Responsibilities:
 *
 * 1. Keep English as the canonical source.
 * 2. Generate a stable hash of source content.
 * 3. Look for an existing cached translation.
 * 4. Return cached translations when available.
 * 5. Delegate actual translation to a provider.
 * 6. Cache successful translations.
 * 7. Never translate secure quiz answers.
 *
 * The actual translation provider is intentionally kept
 * separate from this service.
 */

const DEFAULT_LANGUAGE = 'en';

const SUPPORTED_LANGUAGES = new Set([
  'en',
  'es',
  'fr',
  'de',
  'pt',
  'it',
  'nl',
  'pl',
  'tr',
  'ru',
  'uk',
  'ar',
  'he',
  'fa',
  'hi',
  'bn',
  'ur',
  'id',
  'ms',
  'vi',
  'th',
  'zh',
  'ja',
  'ko',
  'sw',
  'yo',
  'ig',
  'ha'
]);

class TranslationService {
  /*
   * -------------------------------------------------------
   * LANGUAGE VALIDATION
   * -------------------------------------------------------
   */

  isSupportedLanguage(language) {
    return (
      typeof language === 'string' &&
      SUPPORTED_LANGUAGES.has(
        language.toLowerCase()
      )
    );
  }

  normalizeLanguage(language) {
    if (
      typeof language !== 'string'
    ) {
      return DEFAULT_LANGUAGE;
    }

    const normalized =
      language
        .trim()
        .toLowerCase();

    return this.isSupportedLanguage(
      normalized
    )
      ? normalized
      : DEFAULT_LANGUAGE;
  }

  /*
   * -------------------------------------------------------
   * SOURCE HASH
   * -------------------------------------------------------
   *
   * JSON serialization gives us a deterministic representation
   * of the source structure.
   */

  createSourceHash(sourceData) {
    const serialized =
      JSON.stringify(
        sourceData
      );

    return crypto
      .createHash('sha256')
      .update(serialized)
      .digest('hex');
  }

  /*
   * -------------------------------------------------------
   * CACHE LOOKUP
   * -------------------------------------------------------
   */

  async getCachedTranslation({
    sourceType,
    sourceId,
    sourceLanguage = DEFAULT_LANGUAGE,
    targetLanguage,
    sourceHash
  }) {
    return await Translation.findOne({
      sourceType,
      sourceId,
      sourceLanguage,
      targetLanguage,
      sourceHash
    }).lean();
  }

  /*
   * -------------------------------------------------------
   * OPENAI TRANSLATION PROVIDER
   * -------------------------------------------------------
   *
   * Production safety:
   *
   * - The API key is server-side only.
   * - The browser never receives the API key.
   * - OPENAI_API_KEY is optional during development.
   * - If the provider is unavailable, the existing safe
   *   English fallback remains active.
   * - Translation caching remains handled by translateAndCache().
   */

  constructor() {
    this.openai = null;

    this.translationModel =
      process.env.OPENAI_TRANSLATION_MODEL ||
      'gpt-5.6';

    this.translationTimeoutMs =
      Number(
        process.env.OPENAI_TRANSLATION_TIMEOUT_MS ||
        20000
      );

    this.initializeOpenAI();
  }

  initializeOpenAI() {
    const apiKey =
      process.env.OPENAI_API_KEY;

    if (
      typeof apiKey !== 'string' ||
      !apiKey.trim()
    ) {
      console.warn(
        'Miimiid translation provider disabled: OPENAI_API_KEY is not configured.'
      );
      return;
    }

    try {
      const OpenAI =
        require('openai');

      this.openai =
        new OpenAI({
          apiKey: apiKey.trim(),
          timeout:
            this.translationTimeoutMs,
          maxRetries: 2
        });

      console.log(
        `Miimiid OpenAI translation provider ready (${this.translationModel}).`
      );

    } catch (error) {
      this.openai = null;

      console.error(
        'Miimiid could not initialize OpenAI translation provider:',
        error.message
      );
    }
  }

  async translateWithProvider(
    sourceData,
    sourceLanguage,
    targetLanguage,
    sourceType
  ) {
    if (!this.openai) {
      throw new Error(
        'OpenAI translation provider is not configured.'
      );
    }

    const sourceJson =
      JSON.stringify(sourceData);

    const systemPrompt = `
You are the professional translation engine for Miimiid,
a practical financial-literacy learning application.

Translate content from ${sourceLanguage} to ${targetLanguage}.

Rules:

1. Preserve the original meaning exactly.
2. Use natural, fluent language appropriate for native speakers.
3. Preserve financial meaning and terminology.
4. Do not add financial advice.
5. Do not remove important information.
6. Do not summarize.
7. Preserve numbers, percentages, formulas, currency symbols,
   URLs, IDs, and structural identifiers unless they are part
   of ordinary human-readable prose.
8. Preserve the JSON structure of the supplied value.
9. Translate only human-readable content.
10. Return ONLY valid JSON.
11. Return exactly one top-level property named "value".
12. Do not include markdown fences or explanations.

Miimiid content should be clear, practical, relatable, and
easy for an ordinary learner to understand rather than
unnecessarily academic or jargon-heavy.

Content type:
${sourceType}
`;

    const response =
      await this.openai.responses.create({
        model:
          this.translationModel,

        input: [
          {
            role: 'system',
            content: systemPrompt
          },
          {
            role: 'user',
            content:
              `Translate this JSON value:\n${sourceJson}`
          }
        ],
        text: {
          format: {
            type: 'json_object'
          }
        },

        /*
         * Translation requests do not need
         * persistent OpenAI response storage.
         */
        store: false
      });

    const output =
      response &&
      typeof response.output_text === 'string'
        ? response.output_text.trim()
        : '';

    if (!output) {
      throw new Error(
        'OpenAI returned empty translation output.'
      );
    }

    let parsed;

    try {
      parsed =
        JSON.parse(output);
    } catch {
      throw new Error(
        'OpenAI returned invalid translation JSON.'
      );
    }

    if (
      !parsed ||
      !Object.prototype.hasOwnProperty.call(
        parsed,
        'value'
      )
    ) {
      throw new Error(
        'OpenAI translation response is missing the value property.'
      );
    }

    return parsed.value;
  }

  /*
   * -------------------------------------------------------
   * TRANSLATE + CACHE
   * -------------------------------------------------------
   */

  async translateAndCache({
    sourceType,
    sourceId,
    sourceData,
    sourceLanguage = DEFAULT_LANGUAGE,
    targetLanguage
  }) {
    const normalizedSourceLanguage =
      this.normalizeLanguage(
        sourceLanguage
      );

    const normalizedTargetLanguage =
      this.normalizeLanguage(
        targetLanguage
      );

    /*
     * English does not need translation.
     */
    if (
      normalizedTargetLanguage ===
      normalizedSourceLanguage
    ) {
      return sourceData;
    }

    const sourceHash =
      this.createSourceHash(
        sourceData
      );

    /*
     * Return an existing current translation.
     */
    const cached =
      await this.getCachedTranslation({
        sourceType,
        sourceId,
        sourceLanguage:
          normalizedSourceLanguage,
        targetLanguage:
          normalizedTargetLanguage,
        sourceHash
      });

    if (cached) {
      return cached.translatedData;
    }

    /*
     * Generate a new translation.
     */
    const translatedData =
      await this.translateWithProvider(
        sourceData,
        normalizedSourceLanguage,
        normalizedTargetLanguage,
        sourceType
      );

    if (
      translatedData === undefined ||
      translatedData === null
    ) {
      throw new Error(
        'Translation provider returned no translated data.'
      );
    }

    /*
     * Store the translation.
     */
    await Translation.findOneAndUpdate(
      {
        sourceType,
        sourceId,
        sourceLanguage:
          normalizedSourceLanguage,
        targetLanguage:
          normalizedTargetLanguage,
        sourceHash
      },
      {
        sourceType,
        sourceId,
        sourceLanguage:
          normalizedSourceLanguage,
        targetLanguage:
          normalizedTargetLanguage,
        sourceHash,
        translatedData
      },
      {
        upsert: true,
        new: true,
        runValidators: true,
        setDefaultsOnInsert: true
      }
    );

    return translatedData;
  }

  /*
   * -------------------------------------------------------
   * TRANSLATE SIMPLE STRING
   * -------------------------------------------------------
   */

  async translateString({
    sourceType,
    sourceId,
    value,
    targetLanguage,
    fieldName
  }) {
    if (
      typeof value !== 'string' ||
      !value.trim()
    ) {
      return value;
    }

    return await this.translate({
      sourceType,
      sourceId,
      sourceData: {
        field: fieldName,
        value
      },
      targetLanguage
    }).then(result => {
      if (
        result &&
        typeof result === 'object' &&
        typeof result.value === 'string'
      ) {
        return result.value;
      }

      return value;
    });
  }

  /*
   * -------------------------------------------------------
   * TRANSLATE STRING ARRAY
   * -------------------------------------------------------
   */

  async translateStringArray({
    sourceType,
    sourceId,
    values,
    targetLanguage,
    fieldName
  }) {
    if (!Array.isArray(values)) {
      return values;
    }

    if (
      values.length === 0 ||
      targetLanguage === DEFAULT_LANGUAGE
    ) {
      return values;
    }

    const result =
      await this.translate({
        sourceType,
        sourceId,
        sourceData: {
          field: fieldName,
          values
        },
        targetLanguage
      });

    if (
      result &&
      Array.isArray(result.values)
    ) {
      return result.values;
    }

    return values;
  }

  /*
   * -------------------------------------------------------
   * TRANSLATE CONTENT BLOCK
   * -------------------------------------------------------
   *
   * We translate only human-readable data.
   *
   * Structural properties such as:
   * - order
   * - type
   * - URLs
   * - media identifiers
   * remain unchanged.
   */

  async translateContentBlock({
    lessonId,
    block,
    targetLanguage
  }) {
    if (
      !block ||
      typeof block !== 'object'
    ) {
      return block;
    }

    if (
      targetLanguage === DEFAULT_LANGUAGE
    ) {
      return block;
    }

    const data = block.data;

    if (
      data === null ||
      data === undefined
    ) {
      return block;
    }

    /*
     * Strings can be translated directly.
     */
    if (typeof data === 'string') {
      const translated =
        await this.translate({
          sourceType: 'lesson',
          sourceId: lessonId,
          sourceData: {
            blockType: block.type,
            order: block.order,
            data
          },
          targetLanguage
        });

      return {
        ...block,
        data:
          translated?.data ??
          data
      };
    }

    /*
     * Arrays and objects are translated selectively.
     */
    if (
      typeof data === 'object'
    ) {
      const translatableKeys = new Set([
        'text',
        'title',
        'heading',
        'subheading',
        'description',
        'content',
        'label',
        'caption',
        'prompt',
        'question',
        'explanation',
        'hint',
        'instruction',
        'feedback',
        'summary',
        'message',
        'body'
      ]);

      const translatedData = {
        ...data
      };

      for (
        const key of Object.keys(data)
      ) {
        const value = data[key];

        if (
          translatableKeys.has(key) &&
          typeof value === 'string' &&
          value.trim()
        ) {
          const translated =
            await this.translate({
              sourceType: 'lesson',
              sourceId: lessonId,
              sourceData: {
                blockType: block.type,
                order: block.order,
                field: key,
                value
              },
              targetLanguage
            });

          if (
            translated &&
            typeof translated.value === 'string'
          ) {
            translatedData[key] =
              translated.value;
          }
        }

        /*
         * Translate arrays of human-readable strings.
         */
        else if (
          translatableKeys.has(key) &&
          Array.isArray(value)
        ) {
          const translated =
            await this.translate({
              sourceType: 'lesson',
              sourceId: lessonId,
              sourceData: {
                blockType: block.type,
                order: block.order,
                field: key,
                values: value
              },
              targetLanguage
            });

          if (
            translated &&
            Array.isArray(translated.values)
          ) {
            translatedData[key] =
              translated.values;
          }
        }
      }

      return {
        ...block,
        data: translatedData
      };
    }

    return block;
  }

  /*
   * -------------------------------------------------------
   * TRANSLATE LESSON CONTENT BLOCKS
   * -------------------------------------------------------
   */

  async translateLessonContent({
    lessonId,
    contentBlocks,
    targetLanguage
  }) {
    if (
      !Array.isArray(contentBlocks) ||
      targetLanguage === DEFAULT_LANGUAGE
    ) {
      return contentBlocks;
    }

    const translatedBlocks = [];

    for (
      const block of contentBlocks
    ) {
      translatedBlocks.push(
        await this.translateContentBlock({
          lessonId,
          block,
          targetLanguage
        })
      );
    }

    return translatedBlocks;
  }

  /*
   * -------------------------------------------------------
   * TRANSLATE QUIZ
   * -------------------------------------------------------
   *
   * IMPORTANT:
   * correctAnswer is deliberately absent.
   */

  async translateQuiz({
    quiz,
    targetLanguage
  }) {
    if (
      !quiz ||
      targetLanguage === DEFAULT_LANGUAGE
    ) {
      return quiz;
    }

    const data =
      typeof quiz.toObject === 'function'
        ? quiz.toObject()
        : quiz;

    const translated =
      await this.translate({
        sourceType: 'quiz',
        sourceId: data._id,
        sourceData: {
          question: data.question || '',
          context: data.context || '',
          options: Array.isArray(data.options)
            ? data.options
            : [],
          explanation: data.explanation || '',
          hint: data.hint || '',
          correctFeedback:
            data.correctFeedback || '',
          incorrectFeedback:
            data.incorrectFeedback || '',
          skills: Array.isArray(data.skills)
            ? data.skills
            : [],
          learningObjectives:
            Array.isArray(data.learningObjectives)
              ? data.learningObjectives
              : []
        },
        targetLanguage
      });

    return {
      ...data,

      /*
       * Explicitly remove the secure answer.
       */
      correctAnswer: undefined,

      question:
        translated?.question ??
        data.question,

      context:
        translated?.context ??
        data.context,

      options:
        Array.isArray(translated?.options)
          ? translated.options
          : data.options,

      explanation:
        translated?.explanation ??
        data.explanation,

      hint:
        translated?.hint ??
        data.hint,

      correctFeedback:
        translated?.correctFeedback ??
        data.correctFeedback,

      incorrectFeedback:
        translated?.incorrectFeedback ??
        data.incorrectFeedback,

      skills:
        Array.isArray(translated?.skills)
          ? translated.skills
          : data.skills,

      learningObjectives:
        Array.isArray(
          translated?.learningObjectives
        )
          ? translated.learningObjectives
          : data.learningObjectives
    };
  }

  /*
   * -------------------------------------------------------
   * SAFE TRANSLATION ENTRY POINT
   * -------------------------------------------------------
   *
   * English is always safe to return directly.
   *
   * For other languages, provider errors currently fall back
   * to English rather than breaking the learning experience.
   */

  async translate({
    sourceType,
    sourceId,
    sourceData,
    sourceLanguage = DEFAULT_LANGUAGE,
    targetLanguage
  }) {
    const normalizedTargetLanguage =
      this.normalizeLanguage(
        targetLanguage
      );

    if (
      normalizedTargetLanguage ===
      DEFAULT_LANGUAGE
    ) {
      return sourceData;
    }

    try {
      return await this.translateAndCache({
        sourceType,
        sourceId,
        sourceData,
        sourceLanguage,
        targetLanguage:
          normalizedTargetLanguage
      });
    } catch (error) {
      console.error(
        `Miimiid translation failed (${sourceLanguage} -> ${normalizedTargetLanguage}):`,
        error.message
      );

      /*
       * Never destroy the lesson experience because a
       * translation service failed.
       */
      return sourceData;
    }
  }
}

module.exports =
  new TranslationService();

module.exports.TranslationService =
  TranslationService;

module.exports.SUPPORTED_LANGUAGES =
  SUPPORTED_LANGUAGES;
