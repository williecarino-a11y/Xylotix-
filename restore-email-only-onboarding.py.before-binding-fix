# ------------------------------------------------------------
# HELPERS
# ------------------------------------------------------------

def locate_form(text, form_id):
    """
    Locate a form by id without depending on whitespace/formatting.
    Returns (start, end).
    """
    id_match = re.search(
        rf'\bid\s*=\s*"{re.escape(form_id)}"',
        text
    )

    if not id_match:
        raise SystemExit(
            f'STOP: could not find form id="{form_id}".'
        )

    form_start = text.rfind("<form", 0, id_match.start())

    if form_start == -1:
        raise SystemExit(
            f'STOP: opening <form> for {form_id} not found.'
        )

    # The registration form is immediately followed by the
    # forgot-password form. Use that as the reliable boundary.
    if form_id == "miimiid-register-form":
        next_form = re.search(
            r'<form\b[^>]*\bid\s*=\s*"miimiid-forgot-form"',
            text[id_match.end():],
            re.DOTALL
        )

        if not next_form:
            raise SystemExit(
                "STOP: forgot-password form boundary not found."
            )

        relative_start = id_match.end() + next_form.start()
        form_end = relative_start

        # Include nothing from the forgot form itself.
        return form_start, form_end

    # Generic fallback.
    close = text.find("</form>", id_match.end())

    if close == -1:
        raise SystemExit(
            f'STOP: closing </form> for {form_id} not found.'
        )

    return form_start, close + len("</form>")


