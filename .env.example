# Miimiid server configuration
PORT=3000
MONGO_URI=mongodb://localhost:27017/xylotix

# Public application URL used in password-reset links.
# In production, set this to your real HTTPS origin.
APP_BASE_URL=http://localhost:3000

# Account verification / password-reset email
# Use the SMTP credentials supplied by your email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=Miimiid <your-mailbox@example.com>

# AI Tutor. Keep this server-side. Do not put it in public/ or frontend code.
# OPENAI_API_KEY=your-openai-api-key

# Optional production settings
# NODE_ENV=production
# AUTH_COOKIE_NAME=miimiid_session
