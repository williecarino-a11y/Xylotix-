}
  
  /* ================================
     MIIMIID HEADER + LANGUAGE SELECTOR
     ================================ */

  .miimiid-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .miimiid-brand {
    margin: 0;
    color: #38bdf8;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .language-selector {
    position: relative;
  }

  .language-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 9px 12px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .language-toggle:hover,
  .language-toggle:focus-visible {
    border-color: #38bdf8;
    background: #263449;
    outline: none;
  }

  .language-toggle-icon {
    font-size: 1rem;
  }

  .language-chevron {
    font-size: 0.75rem;
    transition: transform 0.2s;
  }

  .language-selector.open .language-chevron {
    transform: rotate(180deg);
  }

  .language-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 230px;
    max-height: 360px;
    overflow-y: auto;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    z-index: 1000;
  }

  .language-menu.hidden {
    display: none;
  }

  .language-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: transparent;
    color: #f8fafc;
    border: none;
    border-radius: 8px;
    padding: 11px 12px;
    cursor: pointer;
    text-align: left;
    font-size: 0.9rem;
  }

  .language-option:hover,
  .language-option:focus-visible {
    background: #334155;
    outline: none;
  }

  .language-option.active {
    background: #0c4a6e;
    color: #7dd3fc;
  }

  .language-option-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .language-option-native {
    color: #94a3b8;
    font-size: 0.78rem;
  }

  .language-option.active .language-option-native {
    color: #bae6fd;
  }

  .language-check {
    font-weight: bold;
    color: #4ade80;
  }

  @media (max-width: 520px) {
    .miimiid-header {
      align-items: flex-start;
    }

    .language-toggle {
      padding: 8px 10px;
    }

    .language-toggle-label {
      display: none;
    }

    .language-menu {
      width: min(230px, calc(100vw - 30px));
    }
  }


/* =========================================================
   MIIMIID APP SHELL — DYNAMIC HOME DASHBOARD
   ========================================================= */

.miimiid-app-shell {
  min-height: 100vh;
  padding-bottom: 82px;
}

.miimiid-dashboard {
  display: none;
}

.miimiid-dashboard.active {
  display: block;
}

.miimiid-dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
}

.miimiid-dashboard-menu {
  position: relative;
}

.miimiid-menu-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid #334155;
  border-radius: 10px;
  background: #1e293b;
  color: #f8fafc;
  cursor: pointer;
  font-size: 20px;
}

.miimiid-menu-toggle:hover,
.miimiid-menu-toggle:focus-visible {
  border-color: #38bdf8;
  outline: none;
}

.miimiid-dashboard-brand {
  margin: 0;
}

.miimiid-dashboard-content {
  display: grid;
  gap: 18px;
}

.miimiid-dashboard-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.miimiid-dashboard-stat {
  min-width: 0;
  padding: 18px;
  border: 1px solid #334155;
  border-radius: 16px;
  background: #1e293b;
}

.miimiid-dashboard-stat-value {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 800;
  color: #f8fafc;
}

.miimiid-dashboard-stat-label {
  margin: 6px 0 0;
  color: #94a3b8;
  font-size: 0.85rem;
}

.miimiid-dashboard-menu-panel {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 1100;
  width: min(240px, calc(100vw - 32px));
  padding: 8px;
  border: 1px solid #334155;
  border-radius: 12px;
  background: #1e293b;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
}

.miimiid-dashboard-menu.open .miimiid-dashboard-menu-panel {
  display: grid;
  gap: 4px;
}

.miimiid-dashboard-menu-item {
  width: 100%;
  border: 0;
  border-radius: 8px;
  padding: 11px 12px;
  background: transparent;
  color: #f8fafc;
  text-align: left;
  cursor: pointer;
}

.miimiid-dashboard-menu-item:hover,
.miimiid-dashboard-menu-item:focus-visible {
  background: #334155;
  outline: none;
}

.miimiid-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1050;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  padding: 8px;
  border-top: 1px solid #334155;
  background: #0f172a;
}

.miimiid-bottom-nav button {
  min-width: 0;
  padding: 9px 5px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  font-size: 0.78rem;
}

.miimiid-bottom-nav button.active,
.miimiid-bottom-nav button:hover,
.miimiid-bottom-nav button:focus-visible {
  background: #1e293b;
  color: #f8fafc;
  outline: none;
}

.miimiid-dashboard-status {
  display: none;
}

@media (min-width: 640px) {
  .miimiid-dashboard-stat-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (min-width: 768px) {
  .miimiid-bottom-nav {
    left: 50%;
    right: auto;
    width: min(680px, calc(100vw - 32px));
    transform: translateX(-50%);
    border: 1px solid #334155;
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
  }
}

</style></head><body>  <header class="miimiid-header">
    <h1 class="miimiid-brand">Miimiid</h1>

