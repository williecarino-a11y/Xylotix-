<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Miimiid</title>  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: #f8fafc;
      padding: 15px;
      margin: 0;
    }

    h1 {
      color: #38bdf8;
      font-size: 1.5rem;
      margin-bottom: 20px;
    }

    h2 {
      color: #38bdf8;
      margin-top: 15px;
    }

    h3 {
      color: #f1f5f9;
      margin-top: 0;
    }

    p {
      line-height: 1.7;
      font-size: 0.95rem;
    }

    .card {
      background: #1e293b;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 8px;
      border: 1px solid #334155;
      overflow-wrap: break-word;
    }

    .btn {
      background: #0284c7;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      width: 100%;
      margin-top: 10px;
    }

    .btn:hover {
      background: #0369a1;
    }

    .btn-sm {
      width: auto;
      padding: 7px 12px;
      font-size: 0.85rem;
      margin-top: 5px;
    }

    .hidden {
      display: none !important;
    }

    #loading {
      color: #38bdf8;
      font-weight: bold;
      margin: 15px 0;
    }

    #error {
      background: #450a0a;
      border: 1px solid #7f1d1d;
      color: #f87171;
      padding: 12px;
      border-radius: 6px;
      margin: 15px 0;
    }

    .success-text {
      color: #4ade80;
      font-weight: bold;
    }

    .error-text {
      color: #f87171;
      font-weight: bold;
    }

    ul {
      padding-left: 20px;
    }

    li {
      margin-bottom: 12px;
    }

    .lesson-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .lesson-row span {
      flex: 1;
      min-width: 150px;
    }

    /* ================================
       LESSON HEADER
       ================================ */

    .lesson-meta {
      margin-top: 6px;
      margin-bottom: 20px;
      padding: 14px 16px;
      border-radius: 8px;
      background: rgba(56, 189, 248, 0.08);
      border-left: 4px solid #38bdf8;
    }

    .lesson-meta-module {
      font-size: 0.9rem;
      font-weight: bold;
      color: #38bdf8;
      margin-bottom: 6px;
    }

    .lesson-meta-details {
      font-size: 0.9rem;
      opacity: 0.8;
      margin-bottom: 8px;
    }

    .lesson-meta-description {
      line-height: 1.6;
      margin: 0;
    }

    /* ================================
       COURSE PROGRESS
       ================================ */

    .course-progress-card {
      margin: 18px 0 24px;
      padding: 18px;
      border-radius: 12px;
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .module-progress {
      margin: 8px 0 14px;
      font-size: 13px;
      opacity: 0.75;
    }

    .module-complete {
      font-weight: 600;
    }

    .lesson-row.completed {
      opacity: 0.9;
    }

    .lesson-completed {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-right: 6px;
      font-size: 13px;
      font-weight: 600;
    }

    .course-progress-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .course-progress-header strong {
      font-size: 16px;
    }

    #course-progress-percent {
      font-weight: bold;
    }

    .course-progress-track {
      width: 100%;
      height: 8px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.18);
    }

    .course-progress-bar {
      height: 100%;
      border-radius: 999px;
      transition: width 0.35s ease;
      background: #38bdf8;
    }

    #course-progress-text {
      margin: 10px 0 0;
      font-size: 14px;
      opacity: 0.8;
    }

    /* ================================
       LESSON CONTENT
       ================================ */

    #lesson-content {
      margin-top: 20px;
    }

    .content-block {
      margin-bottom: 20px;
      line-height: 1.7;
    }

    .content-heading {
      color: #38bdf8;
      margin-bottom: 8px;
    }

    .content-text {
      line-height: 1.8;
      white-space: pre-wrap;
    }

    .content-example {
      background: #172554;
      border-left: 4px solid #38bdf8;
      padding: 14px;
      border-radius: 6px;
    }

    .content-callout {
      background: #422006;
      border-left: 4px solid #f59e0b;
      padding: 14px;
      border-radius: 6px;
    }

    .content-formula {
      background: #020617;
      padding: 14px;
      border-radius: 6px;
      font-family: monospace;
      white-space: pre-wrap;
      overflow-x: auto;
    }

    .content-summary {
      background: #052e16;
      border-left: 4px solid #4ade80;
      padding: 14px;
      border-radius: 6px;
    }

    .content-image {
      display: block;
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin-top: 10px;
    }

.content-video {
  display: block;
  width: 100%;
  max-width: 800px;
  height: auto;
  aspect-ratio: 16 / 9;
  object-fit: contain;
  border-radius: 10px;
  margin: 15px auto 0;
  background: #000;
}

.video-wrapper {
  position: relative;
  width: 100%;
  max-width: 800px;
  margin: 0 auto;
}

.video-watermark {
  position: absolute;
  bottom: 12px;
  right: 12px;

  color: rgba(255, 255, 255, 0.75);
  font-size: 14px;
  font-weight: 600;

  padding: 5px 8px;
  border-radius: 4px;

  background: rgba(0, 0, 0, 0.35);

  pointer-events: none;
  user-select: none;

  z-index: 2;
}

    .content-caption {
      color: #94a3b8;
      font-size: 0.85rem;
      margin-top: 6px;
    }

    /* ================================
       QUIZ
       ================================ */

    .quiz-option {
      display: block;
      background: #0f172a;
      border: 1px solid #334155;
      padding: 12px;
      margin: 8px 0;
      border-radius: 6px;
      cursor: pointer;
    }

    .quiz-option:hover {
      border-color: #38bdf8;
    }

    .quiz-option input {
      margin-right: 8px;
    }

/* ================================
   CALCULATION ANSWER INPUT
   ================================ */

.calculation-input {
  width: 100%;
  padding: 14px 16px;
  margin-top: 10px;

  background: #ffffff;
  color: #111827;

  border: 2px solid #cbd5e1;
  border-radius: 8px;

  font-size: 16px;
  font-weight: 500;

  box-sizing: border-box;
  outline: none;
}

.calculation-input:focus {
  background: #ffffff;
  color: #111827;
  border-color: #2563eb;
}

.calculation-input::placeholder {
  color: #64748b;
  opacity: 1;
}
  
  /* ================================
     MIIMIID HEADER + LANGUAGE SELECTOR
     ================================ */

  .miimiid-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .miimiid-brand {
    margin: 0;
    color: #38bdf8;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .language-selector {
    position: relative;
  }

  .language-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 9px 12px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .language-toggle:hover,
  .language-toggle:focus-visible {
    border-color: #38bdf8;
    background: #263449;
    outline: none;
  }

  .language-toggle-icon {
    font-size: 1rem;
  }

  .language-chevron {
    font-size: 0.75rem;
    transition: transform 0.2s;
  }

  .language-selector.open .language-chevron {
    transform: rotate(180deg);
  }

  .language-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 230px;
    max-height: 360px;
    overflow-y: auto;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    z-index: 1000;
  }

  .language-menu.hidden {
    display: none;
  }

  .language-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: transparent;
    color: #f8fafc;
    border: none;
    border-radius: 8px;
    padding: 11px 12px;
    cursor: pointer;
    text-align: left;
    font-size: 0.9rem;
  }

  .language-option:hover,
  .language-option:focus-visible {
    background: #334155;
    outline: none;
  }

  .language-option.active {
    background: #0c4a6e;
    color: #7dd3fc;
  }

  .language-option-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .language-option-native {
    color: #94a3b8;
    font-size: 0.78rem;
  }

  .language-option.active .language-option-native {
    color: #bae6fd;
  }

  .language-check {
    font-weight: bold;
    color: #4ade80;
  }

  @media (max-width: 520px) {
    .miimiid-header {
      align-items: flex-start;
    }

    .language-toggle {
      padding: 8px 10px;
    }

    .language-toggle-label {
      display: none;
    }

    .language-menu {
      width: min(230px, calc(100vw - 30px));
    }
  }


/* =========================================================
   MIIMIID APP SHELL — DYNAMIC HOME DASHBOARD
   ========================================================= */

.miimiid-app-shell {
  min-height: 100vh;
  padding-bottom: 82px;
}

.miimiid-dashboard {
  display: none;
}

.miimiid-dashboard.active {
  display: block;
}

.miimiid-dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
}

.miimiid-dashboard-menu {
  position: static;
}

.miimiid-menu-toggle {
  position: relative;
  z-index: 1250;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 46px;
  height: 46px;
  padding: 0;

  border: 0;
  border-radius: 12px;

  background: transparent;
  color: #f8fafc;

  cursor: pointer;
  font-size: 28px;
  line-height: 1;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.miimiid-menu-toggle:hover,
.miimiid-menu-toggle:focus-visible {
  background: #1e293b;
  outline: none;
}

.miimiid-menu-toggle:active {
  transform: scale(0.94);
}

.miimiid-dashboard-brand {
  margin: 0;
}

.miimiid-dashboard-content {
  display: grid;
  gap: 18px;
}

.miimiid-dashboard-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.miimiid-dashboard-stat {
  min-width: 0;
  padding: 18px;
  border: 1px solid #334155;
  border-radius: 16px;
  background: #1e293b;
}

.miimiid-dashboard-stat-value {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 800;
  color: #f8fafc;
}

.miimiid-dashboard-stat-label {
  margin: 6px 0 0;
  color: #94a3b8;
  font-size: 0.85rem;
}


/* =========================================================
   MIIMIID LEFT NAVIGATION DRAWER
   ========================================================= */

.miimiid-dashboard-menu-panel {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;

  z-index: 1200;

  width: min(320px, 86vw);
  max-width: 320px;

  display: flex;
  flex-direction: column;
  gap: 4px;

  padding:
    calc(18px + env(safe-area-inset-top))
    14px
    calc(18px + env(safe-area-inset-bottom));

  overflow-y: auto;
  overscroll-behavior: contain;

  background: #0f172a;
  border-right: 1px solid #334155;

  box-shadow:
    18px 0 50px rgba(0, 0, 0, 0.35);

  transform: translateX(-105%);
  visibility: hidden;

  transition:
    transform 0.25s ease,
    visibility 0s linear 0.25s;
}

.miimiid-dashboard-menu.open
.miimiid-dashboard-menu-panel {
  transform: translateX(0);
  visibility: visible;

  transition:
    transform 0.25s ease,
    visibility 0s linear 0s;
}


/* =========================================================
   DRAWER BACKDROP
   ========================================================= */

.miimiid-drawer-backdrop {
  position: fixed;
  inset: 0;

  z-index: 1150;

  background: rgba(0, 0, 0, 0.52);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transition:
    opacity 0.25s ease,
    visibility 0s linear 0.25s;
}

body.miimiid-drawer-open
.miimiid-drawer-backdrop {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transition:
    opacity 0.25s ease,
    visibility 0s linear 0s;
}

body.miimiid-drawer-open {
  overflow: hidden;
}


/* =========================================================
   DRAWER ITEMS
   ========================================================= */

.miimiid-dashboard-menu-item {
  flex: 0 0 auto;

  width: 100%;
  min-height: 54px;

  display: flex;
  align-items: center;

  border: 0;
  border-radius: 12px;

  padding: 14px 16px;

  background: transparent;
  color: #f8fafc;

  text-align: left;
  cursor: pointer;

  font-size: 18px;
  font-weight: 600;
  line-height: 1.3;

  transition:
    background 0.18s ease,
    transform 0.18s ease;
}

.miimiid-dashboard-menu-item:hover,
.miimiid-dashboard-menu-item:focus-visible {
  background: #1e293b;
  outline: none;
}

.miimiid-dashboard-menu-item:active {
  transform: scale(0.985);
}

.miimiid-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1050;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  padding: 8px;
  border-top: 1px solid #334155;
  background: #0f172a;
}

.miimiid-bottom-nav button {
  min-width: 0;
  padding: 9px 5px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  font-size: 0.78rem;
}

.miimiid-bottom-nav button.active,
.miimiid-bottom-nav button:hover,
.miimiid-bottom-nav button:focus-visible {
  background: #1e293b;
  color: #f8fafc;
  outline: none;
}

.miimiid-dashboard-status {
  display: none;
}

@media (min-width: 640px) {
  .miimiid-dashboard-stat-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (min-width: 768px) {
  .miimiid-bottom-nav {
    left: 50%;
    right: auto;
    width: min(680px, calc(100vw - 32px));
    transform: translateX(-50%);
    border: 1px solid #334155;
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
  }
}



    /* =========================================
       MIIMIID AI TUTOR
       ========================================= */

    .miimiid-ai-tutor-view {
      width: 100%;
      padding: 20px;
      box-sizing: border-box;
    }

    .miimiid-ai-tutor-card {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      border-radius: 18px;
      padding: 20px;
      box-sizing: border-box;
      background: var(--card-bg, #ffffff);
      border: 1px solid var(--border-color, #e5e7eb);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

    .miimiid-ai-tutor-header {
      margin-bottom: 16px;
    }

    .miimiid-ai-tutor-header h1 {
      margin: 0 0 6px;
    }

    .miimiid-ai-tutor-header p {
      margin: 0;
      opacity: 0.75;
    }

    .miimiid-ai-tutor-context {
      margin-bottom: 14px;
      padding: 10px 12px;
      border-radius: 10px;
      background: rgba(0, 0, 0, 0.04);
      font-size: 0.9rem;
    }

    .miimiid-ai-tutor-starters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .miimiid-ai-tutor-starter {
      border: 1px solid var(--border-color, #d1d5db);
      background: var(--card-bg, #ffffff);
      border-radius: 999px;
      padding: 8px 12px;
      font: inherit;
      cursor: pointer;
    }

    .miimiid-ai-tutor-starter:hover {
      opacity: 0.85;
    }

    .miimiid-ai-tutor-messages {
      min-height: 360px;
      max-height: 55vh;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 8px 2px;
    }

    .miimiid-ai-tutor-message {
      max-width: 88%;
      padding: 11px 14px;
      border-radius: 14px;
      line-height: 1.5;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .miimiid-ai-tutor-message.user {
      align-self: flex-end;
      background: rgba(0, 0, 0, 0.08);
    }

    .miimiid-ai-tutor-message.assistant {
      align-self: flex-start;
      background: rgba(0, 0, 0, 0.04);
    }

    .miimiid-ai-tutor-status {
      min-height: 22px;
      margin: 8px 0;
      font-size: 0.9rem;
      opacity: 0.75;
    }

    .miimiid-ai-tutor-form {
      display: flex;
      gap: 10px;
      align-items: flex-end;
      margin-top: 8px;
    }

    .miimiid-ai-tutor-input {
      flex: 1;
      min-height: 48px;
      max-height: 180px;
      resize: vertical;
      box-sizing: border-box;
      padding: 12px;
      border-radius: 12px;
      border: 1px solid var(--border-color, #d1d5db);
      font: inherit;
    }

    .miimiid-ai-tutor-send {
      min-height: 48px;
      white-space: nowrap;
    }

    @media (max-width: 640px) {
      .miimiid-ai-tutor-view {
        padding: 12px;
      }

      .miimiid-ai-tutor-card {
        padding: 14px;
      }

      .miimiid-ai-tutor-message {
        max-width: 94%;
      }

      .miimiid-ai-tutor-form {
        flex-direction: column;
        align-items: stretch;
      }

      .miimiid-ai-tutor-send {
        width: 100%;
      }
    }


    /* =========================================
       MIIMIID AUTHENTICATION
       ========================================= */

    .miimiid-auth-view {
      width: 100%;
      min-height: 100vh;
      margin: 0;
      padding: 24px;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .miimiid-auth-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 14px;
      padding: 24px;
    }

    .miimiid-auth-card h1 {
      margin-top: 0;
      margin-bottom: 8px;
    }

    .miimiid-auth-card p {
      opacity: 0.85;
    }

    .miimiid-auth-form {
      margin-top: 20px;
    }

    .miimiid-auth-field {
      margin-bottom: 15px;
    }

    .miimiid-auth-field label {
      display: block;
      margin-bottom: 6px;
      font-weight: bold;
    }

    .miimiid-auth-field input {
      width: 100%;
      padding: 12px;
      border-radius: 7px;
      border: 1px solid #475569;
      background: #0f172a;
      color: #f8fafc;
      font-size: 1rem;
    }

    .miimiid-auth-field input:focus {
      outline: 2px solid #38bdf8;
      outline-offset: 1px;
    }

    .miimiid-auth-password-wrap {
      position: relative;
      width: 100%;
    }

    .miimiid-auth-password-wrap input {
      padding-right: 46px;
      box-sizing: border-box;
    }

    .miimiid-password-toggle {
      position: absolute;
      top: 50%;
      right: 10px;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      margin: 0;
      border: 0;
      background: transparent;
      color: #94a3b8;
      cursor: pointer;
      border-radius: 6px;
      line-height: 1;
    }

    .miimiid-password-toggle:hover {
      color: #f8fafc;
      background: rgba(148, 163, 184, 0.12);
    }

    .miimiid-password-toggle:focus-visible {
      outline: 2px solid #38bdf8;
      outline-offset: 1px;
    }

    .miimiid-password-toggle svg {
      width: 20px;
      height: 20px;
      pointer-events: none;
    }

    .miimiid-auth-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 15px;
    }

    .miimiid-auth-link {
      background: none;
      border: none;
      color: #38bdf8;
      cursor: pointer;
      padding: 9px 0;
      font-size: 1rem;
      font-weight: bold;
    }

    .miimiid-auth-link:hover {
      text-decoration: underline;
    }

    .miimiid-auth-status {
      min-height: 22px;
      margin-top: 14px;
    }

    .miimiid-auth-loading {
      text-align: center;
      padding: 50px 20px;
      color: #38bdf8;
      font-weight: bold;
    }

    .miimiid-auth-user {
      display: flex;
      align-items: center;
